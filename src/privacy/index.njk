<section class="section">
  <div class="container prose">
    <h2>Who we are</h2>
    <p>{{ site.legalName }} (“Bondar Labs”, “we”, “us”). Location: {{ company.locationShort }}.</p>

    <h2>What we collect</h2>
    <ul>
      <li>Contact details you provide (name, email, phone if included)</li>
      <li>Project details and any files/links you submit for quoting</li>
      <li>Basic analytics data (only if you accept analytics cookies, via Google Tag Manager / Google Analytics 4)</li>
