{#
  Page variables expected (front matter):
  - title
  - seoTitle (optional)
  - description (optional)
  - summary / intro (optional)
  - image / coverImage (optional)
  - ogType (optional)
  - ogImageWidth / ogImageHeight / ogImageAlt (optional)
  - noindex (optional)
#}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="{{ site.themeColor }}" />
<meta name="color-scheme" content="dark light" />
<meta name="application-name" content="{{ site.brand }}" />
<meta name="apple-mobile-web-app-title" content="{{ site.brand }}" />
<meta name="author" content="{{ site.legalName }}" />

{# Apply saved theme early to avoid a flash. #}
<script>
  (function () {
    const KEY = "bl_theme_v1";
    const meta = document.querySelector('meta[name="theme-color"]');
    const DARK = "#0b0c0f";
    const LIGHT = "#f7f8fb";

    try {
      const saved = localStorage.getItem(KEY);
      if (saved === "light" || saved === "dark") {
        document.documentElement.setAttribute("data-theme", saved);
        if (meta) meta.setAttribute("content", saved === "light" ? LIGHT : DARK);
        return;
      }
    } catch (e) {}

    // No saved choice: default to dark (the <html> tag already has data-theme="dark").
    if (meta) meta.setAttribute("content", DARK);
  })();
</script>

{# Title / description fallbacks #}
{% set baseTitle = site.defaultTitle or site.brand %}
{% set pageTitle = baseTitle ~ " | " ~ site.brand %}
{% set titleTag = seoTitle or title %}
{% if titleTag %}{% set pageTitle = titleTag ~ " | " ~ site.brand %}{% endif %}

{% set pageDescription = description or summary or intro or site.defaultDescription %}
{% set canonicalUrl = site.baseUrl ~ (page.url | url) %}
{% set breadcrumbItems = page.url | breadcrumbs(title or pageTitle) %}

{# OpenGraph/Twitter image: allow per-page overrides via image or coverImage #}
{% set ogImagePath = image or coverImage or site.ogImage %}
{% set ogImageUrl = site.baseUrl ~ (ogImagePath | url) %}

{# OG type: treat case studies as articles (good for sharing previews) #}
{% set computedOgType = ogType or "website" %}
{% if page.url and (page.url.indexOf('/case-studies/') == 0) and (page.url != '/case-studies/') %}
  {% set computedOgType = 'article' %}
{% endif %}

{# OG image dimensions (defaults match /assets/images/og-preview.jpg = 1200x630) #}
{% set ogW = ogImageWidth or site.ogImageWidth or 1200 %}
{% set ogH = ogImageHeight or site.ogImageHeight or 630 %}
{% set ogAlt = ogImageAlt or site.ogImageAlt or pageTitle %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}" />
<link rel="canonical" href="{{ canonicalUrl }}" />

{# Indexing rules #}
{% if noindex %}
<meta name="robots" content="noindex, nofollow" />
{% else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
{% endif %}

{# Site verification (set values in src/_data/site.json when ready) #}
{% if site.googleSiteVerification %}
<meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />
{% endif %}
{% if site.bingSiteVerification %}
<meta name="msvalidate.01" content="{{ site.bingSiteVerification }}" />
{% endif %}

{# Icons / PWA #}
<link rel="icon" href="{{ '/assets/images/favicon.ico' | url }}" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/brand/icons/icon-32.png' | url }}" />
<link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/images/brand/icons/icon-16.png' | url }}" />
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/brand/icons/icon-180.png' | url }}" />
<link rel="manifest" href="{{ '/assets/site.webmanifest' | url }}" />
<meta name="msapplication-TileColor" content="{{ site.themeColor }}" />
<meta name="msapplication-config" content="{{ '/browserconfig.xml' | url }}" />
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}" />

{# OpenGraph #}
<meta property="og:site_name" content="{{ site.brand }}" />
<meta property="og:type" content="{{ computedOgType }}" />
<meta property="og:title" content="{{ pageTitle }}" />
<meta property="og:description" content="{{ pageDescription }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:image" content="{{ ogImageUrl }}" />
<meta property="og:image:secure_url" content="{{ ogImageUrl }}" />
<meta property="og:image:width" content="{{ ogW }}" />
<meta property="og:image:height" content="{{ ogH }}" />
<meta property="og:image:alt" content="{{ ogAlt }}" />
<meta property="og:locale" content="{{ site.locale }}" />

{# Twitter #}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ pageTitle }}" />
<meta name="twitter:description" content="{{ pageDescription }}" />
<meta name="twitter:image" content="{{ ogImageUrl }}" />
<meta name="twitter:image:alt" content="{{ ogAlt }}" />
{% if site.twitterSite %}
<meta name="twitter:site" content="{{ site.twitterSite }}" />
{% endif %}

{# Basic runtime config for JS (analytics, links, etc.) #}
<script>
  window.BONDAR_SITE = {
    baseUrl: "{{ site.baseUrl }}",
    gtmId: "{{ site.gtmId }}",
    brand: "{{ site.brand }}",
    phoneE164: "{{ company.phoneE164 }}"
  };
  window.dataLayer = window.dataLayer || [];
</script>

{# Structured data: LocalBusiness + WebSite #}
{% set logoUrl = site.baseUrl ~ ('/assets/images/brand/logo.png' | url) %}
{% set sameAs = [] %}
{% if company.social %}
  {% for k, v in company.social %}
    {% if v %}
      {% set sameAs = sameAs.concat([v]) %}
    {% endif %}
  {% endfor %}
{% endif %}

<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": site.legalName,
  "url": site.baseUrl ~ ("/" | url),
  "logo": logoUrl,
  "image": [ogImageUrl],
  "telephone": company.phoneE164,
  "email": company.email,
  "areaServed": company.serviceArea,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": company.addressLine1,
    "addressLocality": company.addressLocality,
    "addressRegion": company.addressRegion,
    "postalCode": company.postalCode,
    "addressCountry": company.addressCountry
  },
  "hasMap": company.mapsUrl,
  "contactPoint": [{
    "@type": "ContactPoint",
    "telephone": company.phoneE164,
    "email": company.email,
    "contactType": "customer service",
    "areaServed": "GB",
    "availableLanguage": ["en"]
  }],
  "identifier": {
    "@type": "PropertyValue",
    "name": "Company number",
    "value": site.companyNumber
  },
  "sameAs": sameAs
} | json(2) | safe }}
</script>

<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.brand,
  "url": site.baseUrl ~ ("/" | url),
  "publisher": {
    "@type": "Organization",
    "name": site.legalName,
    "url": site.baseUrl ~ ("/" | url),
    "logo": {
      "@type": "ImageObject",
      "url": logoUrl
    }
  }
} | json(2) | safe }}
</script>

{% if not noindex and breadcrumbItems and (breadcrumbItems | length) > 1 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {% for crumb in breadcrumbItems %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": {{ crumb.name | json | safe }},
      "item": {{ crumb.url | json | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% if faqItems and (faqItems | length) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqItems %}
    {
      "@type": "Question",
      "name": {{ item.question | json | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | json | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{# Structured data: Article for case studies #}
{% if computedOgType == 'article' %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title or pageTitle,
  "description": pageDescription,
  "image": [ogImageUrl],
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "author": {
    "@type": "Organization",
    "name": site.legalName
  },
  "publisher": {
    "@type": "Organization",
    "name": site.legalName,
    "logo": {
      "@type": "ImageObject",
      "url": logoUrl
    }
  },
  "datePublished": (published or lastmod or page.date) | isoDate,
  "dateModified": (lastmod or page.date) | isoDate
} | json(2) | safe }}
</script>
{% endif %}
