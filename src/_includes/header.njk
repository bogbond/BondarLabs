<header class="site-header" role="banner">
  <div class="container header-inner">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.brand }} home">
      <span class="brand-mark" aria-hidden="true">
        <picture class="brand-mark-light">
          <source srcset="{{ '/assets/images/brand/mark.webp' | url }}" type="image/webp">
          <img class="brand-mark-img" src="{{ '/assets/images/brand/mark.png' | url }}" width="26" height="26" alt="" decoding="async" />
        </picture>
        <picture class="brand-mark-dark">
          <source srcset="{{ '/assets/images/brand/mark-dark.webp' | url }}" type="image/webp">
          <img class="brand-mark-img" src="{{ '/assets/images/brand/mark-dark.png' | url }}" width="26" height="26" alt="" decoding="async" />
        </picture>
      </span>
      <span class="brand-text">{{ site.brand }}</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <div class="nav-mobile-top" aria-hidden="false">
        <div class="nav-mobile-title">Menu</div>
        <button class="nav-close" type="button" data-nav-close aria-label="Close menu">
          <span aria-hidden="true">✕</span>
        </button>
      </div>

      <ul class="nav-list">
        {% for item in nav.items %}
          <li class="nav-item {% if item.children %}has-dropdown{% endif %}">
            <div class="nav-item-row">
              <a class="nav-link" href="{{ item.url | url }}">{{ item.label }}</a>
              {% if item.children %}
                <button class="nav-caret" type="button" aria-label="Toggle {{ item.label }} submenu" aria-expanded="false"></button>
              {% endif %}
            </div>

            {% if item.children %}
              <ul class="dropdown" aria-label="{{ item.label }} submenu">
                {% for child in item.children %}
                  <li><a class="dropdown-link" href="{{ child.url | url }}">{{ child.label }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}

        <li class="nav-item nav-cta">
          <a class="btn btn-primary" href="{{ nav.cta.url | url }}">{{ nav.cta.label }}</a>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
        <span class="theme-toggle-icon" data-theme-icon aria-hidden="true">☾</span>
        <span class="sr-only">Toggle theme</span>
      </button>

      <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
        <span class="sr-only">Menu</span>
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
