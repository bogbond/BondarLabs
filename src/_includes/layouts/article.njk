---
layout: layouts/base.njk
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{{ eyebrow or "Bondar Labs" }}</p>
    <h1>{{ title }}</h1>
    {% if intro %}<p class="lead">{{ intro }}</p>{% endif %}
    <div class="hero-actions">
      <a class="btn btn-primary" href="{{ '/quote/' | url }}">Get a Quote</a>
      <a class="btn btn-ghost" href="{{ '/services/' | url }}">Explore Services</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if coverImage %}
      <div class="page-media">
        <img src="{{ coverImage | url }}" alt="{{ coverAlt or title }}" loading="eager" decoding="async">
      </div>
    {% endif %}

    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</section>

{% if relatedLinks and (relatedLinks | length) %}
<section class="section section-muted">
  <div class="container">
    <h2 class="h3">Related</h2>
    <div class="grid grid-3">
      {% for item in relatedLinks %}
        <a class="card card-link" href="{{ item.url | url }}">
          <div class="card-body">
            <h3 class="h4">{{ item.label }}</h3>
            {% if item.text %}<p>{{ item.text }}</p>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    {% include "partials/cta-wide.njk" %}
  </div>
</section>
