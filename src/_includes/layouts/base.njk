<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    {% include "head.njk" %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "partials/cookie-banner.njk" %}
    {% include "header.njk" %}

    <main id="main" class="site-main">
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}

    <script src="{{ '/assets/js/analytics-consent.js' | url }}?v=3" defer></script>
    <script src="{{ '/assets/js/main.js' | url }}?v=2" defer></script>
    {% if page.url == "/contact/" or page.url == "/quote/" %}<script src="{{ '/assets/js/form-provider.js' | url }}?v=2" defer></script>{% endif %}
    {% if customerReviewSection %}<script src="{{ '/assets/js/customer-reviews.js' | url }}?v=5" defer></script>{% endif %}
  </body>
</html>
