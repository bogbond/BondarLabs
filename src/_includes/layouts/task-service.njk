---
layout: layouts/base.njk
---
<div class="task-service {{ serviceClass }}">
  <section class="task-hero">
    <div class="container">
      <nav class="task-breadcrumb" aria-label="Breadcrumb"><a href="{{ '/services/' | url }}">Services</a><span aria-hidden="true">/</span><span>{{ shortTitle }}</span></nav>
      <div class="task-hero-grid">
        <div class="task-hero-copy">
          <p class="eyebrow">{{ eyebrow }}</p>
          <h1>{{ title }}</h1>
          <p class="lead">{{ intro }}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="{{ '/contact/' | url }}">{{ primaryCta }}</a>
            <a class="btn btn-ghost" href="#real-work">See real projects <span aria-hidden="true">↓</span></a>
          </div>
          <p class="task-start-note">No CAD file needed to start a conversation. Already have a file? <a href="{{ '/quote/' | url }}">Request a quote</a>.</p>
          <p class="task-location">Brampton, Huntingdon, Cambridgeshire · UK-wide shipping</p>
        </div>
        <figure class="task-hero-photo">
          {% if heroSrcset %}
          <img src="{{ heroImage | url }}" srcset="{{ heroSmall | url }} 420w, {{ heroMedium | url }} 720w, {{ heroImage | url }} 1200w" sizes="(max-width: 820px) calc(100vw - 36px), 510px" width="{{ heroWidth }}" height="{{ heroHeight }}" alt="{{ heroAlt }}" fetchpriority="high" decoding="async">
          {% else %}
          <img src="{{ heroImage | url }}" width="{{ heroWidth }}" height="{{ heroHeight }}" alt="{{ heroAlt }}" fetchpriority="high" decoding="async">
          {% endif %}
          <figcaption>{{ heroCaption }}</figcaption>
        </figure>
      </div>
      <nav class="task-jump-links" aria-label="On this page">
        <a href="#starting-point">{{ startLabel }}</a><a href="#real-work">Real work</a><a href="#process">From sample to batch</a><a href="#questions">Questions</a>
      </nav>
    </div>
  </section>

  {{ content | safe }}

  <section class="section section-muted" id="questions">
    <div class="container task-faq-grid">
      <div class="task-section-copy"><p class="eyebrow">Before you enquire</p><h2>Useful things to know</h2><p class="muted">Each job starts with its intended use, the information available and the quantity you need.</p></div>
      <div class="task-faq">
        {% for item in faqItems %}
        <details><summary>{{ item.question }}</summary><div><p>{{ item.answer }}</p></div></details>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section" id="discuss-project">
    <div class="container">
      <div class="task-contact-panel">
        <div><p class="eyebrow">{{ closingEyebrow }}</p><h2>{{ closingTitle }}</h2><p>{{ closingText }}</p><p class="tiny muted">Start with your name, email and a short message. Add photos, drawings or files if you have them; we can ask for the details next.</p></div>
        <div class="task-contact-actions"><a class="btn btn-primary" href="{{ '/contact/' | url }}">{{ primaryCta }}</a><a class="btn btn-ghost" href="{{ '/quote/' | url }}">Have files? Get a Quote</a></div>
      </div>
      <div class="task-next-links"><a href="{{ otherServiceUrl | url }}">{{ otherServiceLabel }} <span aria-hidden="true">→</span></a><a href="{{ '/services/batch-production/' | url }}">Batch &amp; commercial orders <span aria-hidden="true">→</span></a><a href="{{ '/services/design-support/' | url }}">3D design &amp; file support <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</div>

<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": title,
  "serviceType": serviceType,
  "description": description,
  "url": site.baseUrl ~ (page.url | url),
  "provider": {"@type": "Organization", "name": site.legalName, "url": site.baseUrl},
  "areaServed": {"@type": "Country", "name": "United Kingdom"}
} | json(2) | safe }}
</script>
