<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Based near Cambridge · Local delivery &amp; UK-wide shipping</p>
      <h1 class="hero-title">Custom 3D Printed Parts,<br class="hero-title-break"> Prototypes &amp; Small-Batch<br class="hero-title-break"> Production</h1>
      <p class="lead">Bondar Labs turns files, sketches or ideas into functional parts and prototypes for businesses and individuals — from one-off replacement parts to repeat batch orders, with the right process, material and finish.</p>

      <div class="badges hero-use-cases">
        <div class="badge"><span class="dot"></span>Replacement parts</div>
        <div class="badge"><span class="dot"></span>Prototype parts</div>
        <div class="badge"><span class="dot"></span>Enclosures &amp; brackets</div>
        <div class="badge"><span class="dot"></span>Small-batch orders</div>
        <div class="badge"><span class="dot"></span>High-detail resin</div>
        <div class="badge"><span class="dot green"></span>No file? We can help</div>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href="{{ '/quote/' | url }}">Get a Quote</a>
        <a class="btn btn-ghost" href="#portfolio">View Portfolio</a>
      </div>

      <p class="hero-contact-line tiny">
        Prefer to message?
        <a href="{{ company.whatsappUrl }}" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click">WhatsApp</a>
        <span class="sep">·</span>
        <a href="tel:{{ company.phoneE164 }}" data-track="phone_click">Call</a>
        <span class="sep">·</span>
        <a href="mailto:{{ company.email }}" data-track="email_click">Email</a>
      </p>

      <div class="hero-trust">
        <span>Usually replies within 1 hour during working hours</span>
        <span>No minimum order</span>
        <span>Engineering-grade materials</span>
        <span>Invoices available for business orders</span>
      </div>
    </div>

