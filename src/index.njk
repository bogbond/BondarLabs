<section class="section" id="services-overview">
  <div class="container">
    <div class="overview">
      <div class="section-head">
        <h2 class="h2">Services</h2>
        <p class="muted">From one-off replacements to repeatable commercial runs — the main ways clients typically use Bondar Labs.</p>
      </div>

      <div class="overview-grid">
        {% for service in collections.services %}
          <a class="card card-link overview-card overview-card--service overview-card--{{ service.fileSlug }}" href="{{ service.url | url }}">
            <div class="card-media overview-card-media"><img src="{{ service.data.coverImage | url }}" alt="{{ service.data.coverAlt or service.data.title }}" loading="lazy" decoding="async"></div>
            <div class="card-body">
              <div class="kicker">{{ service.data.kicker }}</div>
              <h3 class="h3">{{ service.data.title }}</h3>
              <p class="muted">{{ service.data.summary }}</p>
            </div>
          </a>
        {% endfor %}
      </div>

      <div class="overview-foot">
        <p class="overview-note">Not sure which route fits your job? Send the brief and we’ll point you to the right process.</p>
        <a class="btn btn-ghost" href="{{ '/services/' | url }}">View all services</a>
      </div>
    </div>
  </div>
</section>

<section class="section section-muted" id="how-it-works">
  <div class="container">
    <div class="section-head">
      <h2 class="h2">How it works</h2>
      <p class="muted">Simple for one-off parts, clear enough for repeat business orders and reorders.</p>
    </div>

    <div class="grid process-grid mt-16">
      <div class="card process-card">
        <div class="card-body">
          <div class="process-step">Step 1</div>
          <h3 class="h3">Send a file, sketch or photo</h3>
          <p class="muted">STL, STEP and 3MF are ideal — but measurements, reference photos or a rough brief also work.</p>
        </div>
      </div>

      <div class="card process-card">
        <div class="card-body">
          <div class="process-step">Step 2</div>
          <h3 class="h3">Get a practical recommendation</h3>
          <p class="muted">We suggest the right process, material and finish, then confirm price and lead time before production starts.</p>
        </div>
      </div>

      <div class="card process-card">
        <div class="card-body">
          <div class="process-step">Step 3</div>
          <h3 class="h3">Approve and we print</h3>
          <p class="muted">Once approved, the job is scheduled, produced and checked so the parts arrive ready for real use.</p>
        </div>
      </div>

      <div class="card process-card">
        <div class="card-body">
          <div class="process-step">Step 4</div>
          <h3 class="h3">Collect, receive or reorder</h3>
          <p class="muted">Choose local delivery or UK-wide shipping. Repeat orders can be rerun with the same agreed setup.</p>
        </div>
      </div>
    </div>

    <div class="hero-actions mt-16">
      <a class="btn btn-primary" href="{{ '/quote/' | url }}">Send a file or brief</a>
      <a class="btn btn-ghost" href="{{ '/contact/' | url }}">Ask a question</a>
    </div>
  </div>
</section>

<section class="section" id="materials-overview">
  <div class="container">
    <div class="overview">
      <div class="section-head">
        <h2 class="h2">Materials</h2>
        <p class="muted">Start with the result you need — fast prototypes, tougher functional parts, outdoor durability or fine-detail resin work.</p>
      </div>

      <div class="overview-grid">
        <a class="card card-link overview-card overview-card--material overview-card--pla" href="{{ '/materials/pla/' | url }}">
          <div class="card-media overview-card-media"><img src="{{ '/assets/images/materials/pla-branded-threaded-caps.webp' | url }}" alt="Colourful branded PLA threaded caps with knurled grip arranged in rows" loading="lazy" decoding="async"></div>
          <div class="card-body">
            <div class="kicker">Everyday prototypes</div>
            <h3 class="h3">PLA</h3>
            <p class="muted">Clean prototypes, branded caps, cosmetic parts and everyday prints with sharp detail and fast turnaround.</p>
          </div>
        </a>

        <a class="card card-link overview-card overview-card--material overview-card--asa" href="{{ '/materials/asa/' | url }}">
          <div class="card-media overview-card-media"><img src="{{ '/assets/images/materials/asa-intake-flow-straighteners.webp' | url }}" alt="Two black ASA intake flow straighteners with honeycomb cells shown close up" loading="lazy" decoding="async"></div>
          <div class="card-body">
            <div class="kicker">Heat &amp; outdoors</div>
            <h3 class="h3">ABS &amp; ASA</h3>
            <p class="muted">A stronger choice for warm environments, engine-bay parts, workshop use and outdoor exposure where PLA is not ideal.</p>
          </div>
        </a>

        <a class="card card-link overview-card overview-card--material overview-card--carbon" href="{{ '/materials/carbon-fibre-composites/' | url }}">
          <div class="card-media overview-card-media"><img src="{{ '/assets/images/materials/carbon-fibre-asa-tray.webp' | url }}" alt="Matte black carbon-fibre ASA tray with tall side walls and layered finish" loading="lazy" decoding="async"></div>
          <div class="card-body">
            <div class="kicker">High stiffness</div>
            <h3 class="h3">Carbon-filled composites</h3>
            <p class="muted">Stiffer matte-finish trays, tooling, brackets and functional parts where rigidity matters more than flex.</p>
          </div>
        </a>

        <a class="card card-link overview-card overview-card--material overview-card--resin" href="{{ '/materials/resin/' | url }}">
          <div class="card-media overview-card-media"><img src="{{ '/assets/images/materials/resin-grey-mechanical-parts.webp' | url }}" alt="Grey resin mechanical parts including housings, gears and small lever components" loading="lazy" decoding="async"></div>
          <div class="card-body">
            <div class="kicker">Fine detail</div>
            <h3 class="h3">Resin options</h3>
            <p class="muted">Smooth surfaces, crisp edges and small mechanical parts with a full wash, dry and UV-cure workflow included.</p>
          </div>
        </a>
      </div>

      <div class="overview-foot">
        <p class="overview-note">Not sure which material fits? Tell us what the part needs to do and we’ll recommend the safest option.</p>
        <a class="btn btn-ghost" href="{{ '/materials/' | url }}">View material guide</a>
      </div>
    </div>
  </div>
</section>

<section class="section" id="portfolio">
  <div class="container">
    <div class="carousel" data-carousel>
      <div class="carousel-head">
        <div class="carousel-copy">
          <h2 class="h2">Portfolio</h2>
          <p class="muted">Selected repairs, prototype parts, detail-led resin work and repeat production.</p>
        </div>

        <div class="carousel-controls" aria-label="Portfolio carousel controls">
          <button class="carousel-btn" type="button" data-carousel-prev aria-label="Scroll portfolio left">
            <span aria-hidden="true">←</span>
          </button>
          <button class="carousel-btn" type="button" data-carousel-next aria-label="Scroll portfolio right">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>

      <div class="carousel-track" data-carousel-track aria-label="Portfolio examples" tabindex="0">
        {% for cs in collections.caseStudies %}
          <a class="card card-link carousel-item" href="{{ cs.url | url }}">
              <div class="card-media"><img src="{{ (cs.data.listingImage or cs.data.coverImage) | url }}" alt="{{ cs.data.listingAlt or cs.data.coverAlt or cs.data.title }}" loading="lazy" decoding="async"></div>
              <div class="card-body">
                <div class="kicker">{{ cs.data.tech }}</div>
                <h3 class="h3">{{ cs.data.title }}</h3>
                <p class="muted">{{ cs.data.summary }}</p>
              </div>
            </a>
        {% endfor %}

        <a class="card card-link carousel-item case-card-all" href="{{ '/case-studies/' | url }}" aria-label="View portfolio">
          <div class="case-card-all-media" aria-hidden="true">
            <span class="case-card-all-arrow">→</span>
          </div>
          <div class="card-body">
            <div class="kicker">Explore</div>
            <h3 class="h3">View Portfolio</h3>
            <p class="muted">Open the full portfolio</p>
          </div>
        </a>
      </div>

      <div class="mt-16">
        <a class="btn btn-ghost" href="{{ '/case-studies/' | url }}">View Portfolio</a>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {% include "partials/cta-wide.njk" %}
  </div>
</section>
