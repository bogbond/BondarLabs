---
layout: layouts/base.njk
title: Contact
customerReviewSection: true
seoTitle: "Contact Bondar Labs | 3D Printing Near Cambridge"
description: "Contact Bondar Labs in Brampton, Huntingdon for 3D printing quotes, file support and production help. UK-wide shipping and local collection by appointment."
image: "/assets/images/og/contact.jpg"
ogImageAlt: "Bondar Labs contact page OG image."
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Bondar Labs · Contact</p>
    <h1>Contact</h1>
    <p class="lead">Fast response — {{ company.responseTime }}.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-2 contact-top-grid">
      <div class="card contact-details-card">
        <div class="card-body contact-details-body">
          <h2 class="h3">Details</h2>

          <dl class="contact-methods">
            <div><dt>Email</dt><dd><a href="mailto:{{ company.email }}" data-track="email_click">{{ company.email }}</a></dd></div>
            <div><dt>Phone</dt><dd><a href="tel:{{ company.phoneE164 }}" data-track="phone_click">{{ company.phone }}</a></dd></div>
          </dl>
          <a class="btn contact-whatsapp" href="{{ company.whatsappUrl }}" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.6-4.6A9 9 0 1 1 21 11.5Z"/><path d="M8 7.5c-.8 3.8 2.7 7.3 6.5 7l1-2-2-.8-.8 1c-1.6-.6-2.8-1.8-3.4-3.4l1-.8-.8-2Z"/></svg><span>WhatsApp</span></a>

          <div class="card contact-delivery-card">
            <div class="card-body">
              <div class="kicker">Delivery</div>
              <p class="muted" style="margin:8px 0 0">Local delivery from £5 (same-day on request). UK shipping from £2.75. Tracked options available.</p>
              <div class="hero-actions">
                <a class="btn btn-ghost" href="{{ '/delivery/' | url }}">See delivery options</a>
                <a class="btn btn-primary" href="{{ '/quote/' | url }}">Get a Quote</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h2 class="h3">Send a message</h2>
          <form class="form" id="contactForm" method="POST" action="https://formly.email/submit" data-formly-relay data-formly-title="Contact form — Bondar Labs">
            <input type="hidden" name="access_key" value="{{ site.formlyAccessKey }}" />
            <div class="field">
              <label class="label" for="c-name">Name</label>
              <input class="input" id="c-name" name="Name" type="text" autocomplete="name" autocapitalize="words" />
            </div>
            <div class="field">
              <label class="label" for="c-email">Email *</label>
              <input class="input" id="c-email" type="email" name="Email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required />
            </div>
            <div class="field">
              <label class="label" for="c-message">Message *</label>
              <textarea class="textarea" id="c-message" name="Message" required></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Send</button>
            <p class="tiny muted">For quotes with files, please use the <a href="{{ '/quote/' | url }}">quote form</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "partials/contact-map.njk" %}

{% include "partials/contact-reviews.njk" %}
